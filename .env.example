# Example environment. Copy to `.env` or export these before `node server.js`.
# Every value below is a default; the file exists to document what can change.

# ── Where this listens ──────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Which catalogues are asked, in priority order ───────────────────────────
#   tidal   Tidal, via Monochrome's public index. No credentials. ~1.6 s.
#   archive Internet Archive. No credentials. Freely-licensed recordings.
#
# `SOURCES=tidal` is the fastest configuration and the one to use when you are
# asking whether FLAC plays at all, rather than whether the addon is thorough.
SOURCES=tidal,archive

# ── The Tidal-backed index ──────────────────────────────────────────────────
# Repoint this if the public instance moves. No code change required.
TIDAL_BASE_URL=https://tracks.monochrome.st

# ── Audio delivery ──────────────────────────────────────────────────────────
# 0 (default) — BitChord opens the upstream URL directly. Nothing to proxy, no
#              bandwidth here, one less thing to fail.
# 1          — audio is served through this host, which gives a real `.flac`
#              path and an `audio/flac` content type. Costs your bandwidth.
PROXY=0

# ── Access ──────────────────────────────────────────────────────────────────
# If set, every route requires ?token=<value>. BitChord keeps the token from the
# URL you paste and appends it to later calls, so you only type it once.
# Generate one with: openssl rand -hex 16
# ADDON_TOKEN=
